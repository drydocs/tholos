# Copy to .env and fill in. See README.md for what each variable does and
# which are optional. Never commit a filled-in .env (contract addresses and
# webhook URLs aren't committed to source; see CONTRIBUTING.md).

# At least one of the two contract ids below is required.
THOLOS_V1_CONTRACT_ID=
THOLOS_V2_CONTRACT_ID=

# Required: any endpoint that accepts a JSON POST (Slack/Discord incoming
# webhook, or your own).
ALERT_WEBHOOK_URL=

# Optional overrides — leave unset to use the defaults in README.md.
SOROBAN_RPC_URL=
NETWORK_PASSPHRASE=
ALERT_MIN_SEVERITY=
STATE_FILE_PATH=
CONSECUTIVE_FAILURES_BEFORE_ALERT=
REQUEST_TIMEOUT_MS=
INITIAL_LEDGER_LOOKBACK=
